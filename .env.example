# Body Clock Kit environment variables.
# Phase 1 (the app as shipped) needs NONE of these.
# Phase 2: copy this file to .env.local for local dev, and add the same names
# in Vercel > Project > Settings > Environment Variables.

# Neon (added from Vercel > Storage > Neon; it sets this for you)
DATABASE_URL=

# Resend login codes (sent from the Resend onboarding sender to OWNER_EMAIL only)
RESEND_API_KEY=
OWNER_EMAIL=
# address:Name pairs, comma separated
ALLOWED_EMAILS=

# Random 32+ character string for signing session cookies (openssl rand -base64 32)
SESSION_SECRET=

# Web push (generate once: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:

# Shared secret that the free scheduler (QStash or cron-job.org) sends to /api/cron
CRON_SECRET=
